{
  "$schema": "https://json-schema.org/schema",
  "$id": "ShellGenerator",
  "title": "Create a domain shell",
  "description": "Creates the routing and composition boundary for a bounded context.",
  "type": "object",
  "cli": "nx",
  "properties": {
    "name": {
      "type": "string",
      "description": "Bounded-context name, for example orders.",
      "x-prompt": "What is the bounded-context name?"
    },
    "directory": {
      "type": "string",
      "description": "Directory containing bounded contexts.",
      "default": "libs/domains"
    }
  },
  "required": ["name"],
  "additionalProperties": false
}
